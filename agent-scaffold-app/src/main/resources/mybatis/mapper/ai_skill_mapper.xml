<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="daoha.top.infrastructure.dao.IAiSkillDao">

    <resultMap id="AiSkillResultMap" type="daoha.top.infrastructure.dao.po.AiSkillPO">
        <id column="id" property="id"/>
        <result column="app_id" property="appId"/>
        <result column="skill_code" property="skillCode"/>
        <result column="resource_type" property="resourceType"/>
        <result column="resource_path" property="resourcePath"/>
        <result column="status" property="status"/>
        <result column="sort_no" property="sortNo"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="BaseColumns">
        id, app_id, skill_code, resource_type, resource_path,
        status, sort_no, created_at, updated_at
    </sql>

    <select id="queryById" resultMap="AiSkillResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM ai_skill
        WHERE id = #{id}
        LIMIT 1
    </select>

    <select id="queryEnabledByAppId" resultMap="AiSkillResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM ai_skill
        WHERE app_id = #{appId}
          AND status = 1
        ORDER BY sort_no, id
    </select>

</mapper>
